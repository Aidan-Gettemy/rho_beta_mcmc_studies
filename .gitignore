__pycache__/
*.pyc
runs/quick/
*.tmp.npz
.DS_Store

# build-once KLE / truth store of each study (runs keep frozen copies)
store/
**/store/

# SLURM logs (the folder itself is kept: SLURM will not create it)
logs/*
!logs/.gitkeep
# raw sampler output stays on the cluster; commit figures/ tables/ manifests
**/results/**/chain*.npz
**/results/**/pairs/
reports/linearized/*.npz
reports/linearized/*.npy
reports/linearized/out_*.txt

# external solver, its inputs and matrices stay out of git (external/README.md)
external/solver.local
external/solver/
external/matrices/
external/data/
external/fields/
# MSM local-KLE study: raw chains stay on the cluster (summary.json and post/ are committed)
runs/msm_local_kle_*/**/chains.npz
runs/msm_local_kle_*/**/post/fields.npz
